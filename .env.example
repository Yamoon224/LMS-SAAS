# ============================================================
# SaaS LMS — variables d'environnement (racine du monorepo)
# Copier vers .env et adapter. Ne jamais committer le .env réel.
# ============================================================

# --- Domaine & routage multi-tenant (section 3.3) ---
APP_BASE_DOMAIN=votredomaine.local
APP_PROTOCOL=http

# --- Backend NestJS ---
NODE_ENV=development
PORT=3001
API_PREFIX=v1
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_TTL=7d

# --- Base de données (PostgreSQL via docker-compose) ---
DATABASE_URL="postgresql://saas_lms:saas_lms_dev@localhost:5432/saas_lms?schema=public"

# --- Redis (cache, sessions, BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Stockage objet compatible S3 (MinIO en local, AWS S3 en prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=saas-lms-dev
S3_ACCESS_KEY_ID=saas_lms
S3_SECRET_ACCESS_KEY=saas_lms_dev_secret
S3_FORCE_PATH_STYLE=true

# --- Antivirus des uploads (étape 28) : clamd en TCP (protocole INSTREAM) ---
# Sans CLAMAV_HOST : analyse désactivée (développement uniquement, avertissement journalisé).
# MEDIA_SCAN_REQUIRED=true (production) : aucun fichier n'est servi tant qu'il n'a pas été analysé.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Doit rester <= StreamMaxLength de clamd (clamd.conf) ; au-delà, le fichier est refusé.
CLAMAV_MAX_SCAN_BYTES=104857600
CLAMAV_IDLE_TIMEOUT_MS=15000
CLAMAV_TOTAL_TIMEOUT_MS=300000
MEDIA_SCAN_REQUIRED=false

# --- Conservation des données personnelles (étape 28) : mettre "false" pour désactiver la purge ---
RETENTION_PURGE_ENABLED=true

# --- AWS (vidéo : MediaConvert + CloudFront) — à renseigner en prod ---
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# --- E-mail (SMTP local = Mailpit via docker-compose) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="SaaS LMS <no-reply@votredomaine.local>"
MAIL_PROVIDER=smtp

# --- Fournisseurs de paiement (Côte d'Ivoire, section 9.2) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PIXEL_INNOV_API_KEY=
PIXEL_INNOV_API_SECRET=

# --- IA (traduction, section 6.3.5) ---
AI_TRANSLATION_PROVIDER=
AI_TRANSLATION_API_KEY=

# --- Google (Meet / Calendar, section 6.3.6) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/v1/integrations/google/callback

# --- Observabilité ---
# BE-11 : vide = Sentry désactivé (backend et fronts). Les erreurs 4xx/domaine ne sont jamais remontées.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# DSN navigateur des fronts Next.js (figé au build) ; vide = désactivé.
NEXT_PUBLIC_SENTRY_DSN=

# --- Fronts Next.js (admin, business, learning) ---
NEXT_PUBLIC_API_URL=http://api.votredomaine.local:3001/v1
NEXT_PUBLIC_APP_BASE_DOMAIN=votredomaine.local

# 2FA obligatoire pour admins/propriétaires (défaut). "false" = optionnelle, développement uniquement.
TWO_FACTOR_MANDATORY=true
