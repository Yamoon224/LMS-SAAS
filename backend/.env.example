# Copier vers .env. Voir aussi le .env.example à la racine du monorepo.
NODE_ENV=development
PORT=3001
API_PREFIX=v1
APP_BASE_DOMAIN=votredomaine.local

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_TTL=7d

DATABASE_URL="postgresql://saas_lms:saas_lms_dev@localhost:5432/saas_lms?schema=public"
REDIS_URL="redis://localhost:6379"

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=saas-lms-dev
S3_ACCESS_KEY_ID=saas_lms
S3_SECRET_ACCESS_KEY=saas_lms_dev_secret
S3_FORCE_PATH_STYLE=true

# Antivirus des uploads (clamd, INSTREAM/TCP). Vide = désactivé (dev). MEDIA_SCAN_REQUIRED=true en production.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_MAX_SCAN_BYTES=104857600
MEDIA_SCAN_REQUIRED=false
# Purge RGPD (notifications lues > 12 mois, comptes inactifs > 36 mois) ; "false" pour désactiver.
RETENTION_PURGE_ENABLED=true

TRANSLATION_API_URL=https://api-free.deepl.com/v2/translate
TRANSLATION_API_KEY=change_me_translation_api_key

GOOGLE_SERVICE_ACCOUNT_EMAIL=change_me@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange_me\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@votredomaine.local

SMS_API_URL=
SMS_API_KEY=change_me_sms_api_key
SMS_SENDER_ID=SaaSLMS

# ADM-34 : coût fournisseur estimé de la traduction IA, par mot traduit (même devise que les prix des packs de crédits).
# Laisser vide tant que le tarif du fournisseur n'est pas connu : coût et marge s'affichent alors « non configurés ».
AI_TRANSLATION_COST_PER_WORD=

# Etape 27 : double authentification (TOTP). SECRETS_ENCRYPTION_KEY est OBLIGATOIRE (chiffre les secrets TOTP, ne plus la changer) :
# sans elle, les comptes soumis a la 2FA obligatoire ne peuvent plus se connecter. Nom affiche dans l application d authentification.
TOTP_ISSUER=SaaS LMS
