# API backend NestJS
NEXT_PUBLIC_API_URL=http://api.votredomaine.local:3001/v1

# Domaine de base utilisé pour résoudre les sous-domaines tenants ({slug}.domaine)
NEXT_PUBLIC_APP_BASE_DOMAIN=votredomaine.local

# DEV UNIQUEMENT (ignoré en production) : slug de tenant utilisé quand l'app est
# ouverte sur localhost sans sous-domaine. Évite de modifier le fichier hosts.
# LEARNING_DEV_TENANT_SLUG=acme
