# Copier vers deploy/.env.prod (jamais committé) et renseigner. Utilisé par docker compose (--env-file ET env_file).
# Générer les secrets avec : openssl rand -base64 48

# --- Domaine ---
APP_BASE_DOMAIN=example.com
APP_PROTOCOL=https
NEXT_PUBLIC_API_URL=https://api.example.com/v1
ACME_EMAIL=ops@example.com

# --- Certificat joker (DNS-01) : module Caddy + jeton API de la zone DNS ---
DNS_PLUGIN=cloudflare
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=
MAX_UPLOAD_SIZE=110MB

# --- Images ---
IMAGE_PREFIX=saas-lms
IMAGE_TAG=latest

# --- PostgreSQL / Redis (DATABASE_URL et REDIS_URL sont composés par docker-compose) ---
POSTGRES_USER=saas_lms
POSTGRES_PASSWORD=
POSTGRES_DB=saas_lms
REDIS_PASSWORD=

# --- Backend ---
PORT=3001
API_PREFIX=v1
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
TWO_FACTOR_MANDATORY=true
RETENTION_PURGE_ENABLED=true

# --- Stockage S3 (AWS S3 en prod ; profil "minio" pour un stockage local : S3_ENDPOINT=http://minio:9000) ---
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Antivirus (profil "antivirus" : CLAMAV_HOST=clamav) ---
CLAMAV_HOST=
CLAMAV_PORT=3310
MEDIA_SCAN_REQUIRED=true

# --- E-mail, paiements, IA, Google, AWS vidéo : voir .env.example ---
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_PROVIDER=smtp
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PIXEL_INNOV_API_KEY=
PIXEL_INNOV_API_SECRET=
AI_TRANSLATION_PROVIDER=
AI_TRANSLATION_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/v1/integrations/google/callback

# --- Observabilité (vide = désactivé) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=

# --- Sauvegardes (deploy/backup) ---
BACKUP_DIR=/var/backups/saas-lms
BACKUP_PASSPHRASE_FILE=/etc/saas-lms/backup.pass
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_S3_URI=
