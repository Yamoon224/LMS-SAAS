# syntax=docker/dockerfile:1.7
# Front Next.js (admin, business ou learning) — sortie « standalone », utilisateur non-root.
# Contexte de build : racine du dépôt.
#   docker build -f deploy/docker/Dockerfile.next --build-arg APP=admin \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com/v1 \
#     --build-arg NEXT_PUBLIC_APP_BASE_DOMAIN=example.com -t saas-lms-admin .
# Les variables NEXT_PUBLIC_* sont figées dans le bundle au build : une image par environnement/domaine.

ARG NODE_VERSION=20
ARG PNPM_VERSION=9.15.0

FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
ENV HUSKY=0 CI=true NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat \
 && corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /repo

FROM base AS build
ARG APP
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_BASE_DOMAIN
ARG NEXT_PUBLIC_SENTRY_DSN=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_APP_BASE_DOMAIN=${NEXT_PUBLIC_APP_BASE_DOMAIN} \
    NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN} \
    NEXT_OUTPUT=standalone
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY admin/package.json admin/
COPY business/package.json business/
COPY learning/package.json learning/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter ${APP}...
COPY ${APP} ${APP}
RUN pnpm --filter ${APP} build
# Les dossiers public/ sont optionnels : on garantit leur existence pour le COPY de l'étape finale.
RUN mkdir -p ${APP}/public

FROM node:${NODE_VERSION}-alpine AS runtime
ARG APP
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 APP_DIR=${APP}
WORKDIR /app
# Racine de traçage = racine du monorepo : server.js se trouve dans /app/<app>/.
COPY --from=build --chown=node:node /repo/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /repo/${APP}/.next/static ./${APP}/.next/static
COPY --from=build --chown=node:node /repo/${APP}/public ./${APP}/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node ${APP_DIR}/server.js"]
