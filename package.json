{
  "name": "saas-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme SaaS LMS multi-entreprises - monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:a11y": "playwright test --config e2e/playwright.config.ts --project=a11y-admin --project=a11y-business --project=a11y-learning",
    "test:load:smoke": "node load/node-smoke.mjs",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:seed:demo": "pnpm --filter backend db:seed:demo",
    "arch:check": "depcruise --config .dependency-cruiser.cjs backend/src"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.65.1",
    "dependency-cruiser": "^16.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
